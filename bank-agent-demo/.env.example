# أي نموذج يعمل خلف الوكيل: anthropic | local | scripted
# إذا لم تحدده: anthropic عند وجود مفتاح، وإلا scripted (محاكاة بدون إنترنت)
LLM_PROVIDER=

# Claude عبر Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# عمق التفكير: low | medium | high | xhigh | max  (low أسرع للعرض، ونجح في كل حالات التقييم)
EFFORT=low

# نموذج مفتوح داخل البنك عبر واجهة متوافقة مع OpenAI (Ollama أو vLLM)
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:14b
LOCAL_API_KEY=

PROMPT_VERSION=sanad-v2

# وضع المحاكاة: ثوانٍ بين الخطوات ليتابع الحضور لوحة «خلف الكواليس»
SIM_DELAY=0.7
